{
  "name": "@project-status/mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "Optional read-only MCP companion for a Project Status manifest",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/server.js"
  },
  "bin": {
    "project-status-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --charset=utf8 --legal-comments=eof",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.25.12",
    "typescript": "^6.0.0"
  }
}
